# =============================================================================
# LLM Gateway — Environment Variables
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control — it is in .gitignore.
# =============================================================================

# --- Django Core ---
DJANGO_SETTINGS_MODULE=config.settings.development
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- PostgreSQL (django-environ URL format) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://gateway_user:gateway_pass@localhost:5432/llm_gateway

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM Provider Keys (populated in Phase 3) ---
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Langfuse Telemetry (populated in Phase 7) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Gateway Routing Config (Phase 4+) ---
DEFAULT_ROUTING_STRATEGY=cost_optimized
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30
